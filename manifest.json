{
  "manifest_version": 3,
  "name": "Assistente V8",
  "version": "1.0.0",
  "description": "Auxilia no fluxo de consulta de margem.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://app.v8sistema.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.v8sistema.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}